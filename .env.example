# ==============================================================================
# SecondBrain — Environment Variables Example
# Copy this file to .env and fill in real values for your environment.
# NEVER commit .env or real secrets to the repository.
# ==============================================================================

# Database (PostgreSQL 16 — local Docker or Neon/Supabase)
DATABASE_URL="postgresql://secondbrain:secondbrain@localhost:5432/secondbrain?schema=public"
DIRECT_URL="postgresql://secondbrain:secondbrain@localhost:5432/secondbrain?schema=public"
DATABASE_URL_TEST="postgresql://secondbrain:secondbrain@localhost:5432/secondbrain_test?schema=public"

# Docker Compose PostgreSQL defaults (optional)
POSTGRES_USER="secondbrain"
POSTGRES_PASSWORD="secondbrain"
POSTGRES_DB="secondbrain"
POSTGRES_PORT="5432"

# BetterAuth (generate a strong 32+ char secret: openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-with-a-secure-random-string-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Exclusive Personal Access (FAIL-CLOSED — must match your Google account email)
ALLOWED_EMAIL="you@example.com"

# Google OAuth + Gmail Read-Only (from Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# WebAuthn / Passkeys
PASSKEY_RP_ID="localhost"
PASSKEY_RP_NAME="SecondBrain"
PASSKEY_ORIGIN="http://localhost:3000"

# Optional AI/LLM Fallback Parser (set LLM_PROVIDER to openai, gemini, or anthropic)
LLM_PROVIDER="none"
LLM_API_KEY=""
LLM_BASE_URL=""
LLM_MODEL=""

# Optional Cron Secret for scheduled recurring/sync endpoints
CRON_SECRET=""
